DATABASE_URL=postgres://YourUserName:YourPassword@YourHostname:5432/YourDatabaseName
JWT_SECRET=
COOKIE_SECRET=
PORT=
BCRYPT_SALT=
# Lista de origens permitidas separadas por vírgula (ex.: https://app.exemplo.com,http://localhost:3000).
# Se vazio, requisições cross-origin são bloqueadas por padrão.
CORS_ORIGIN=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# URL do frontend usada para montar o link de redefinição de senha (ex.: https://app.exemplo.com)
FRONTEND_URL=
# Configuração de SMTP para envio de e-mails (redefinição de senha e envio de orçamentos)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
